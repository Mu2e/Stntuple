# -*- mode:tcl -*-
#------------------------------------------------------------------------------
# cr_rxxx_n007: reconstruct, write output file, DO NOT NTUPLE
#
#------------------------------------------------------------------------------
BEGIN_PROLOG
  bgHitFiles                  : @nil
  INPUT_MODULE @protect_ignore: RootInput
  TRIGGER_PATH @protect_ignore: ""                  ## ntupling only
  PROCESS_NAME @protect_ignore: Cr110N007
END_PROLOG

#include "Stntuple/fcl/stntuple.fcl"
#------------------------------------------------------------------------------
# services.DbService and services.ProditionsService
#------------------------------------------------------------------------------
#include "rundb/latest/calibration_set_v110.fcl"
process_name : @local::PROCESS_NAME

#include "Stntuple/fcl/physics_table.fcl"
#------------------------------------------------------------------------------
physics.path_t0       : [ # EventIDFilter,
                         EWMProducer
                         , makeSD, makeSH, TimeCluster                           ## tracker
                         , CaloDigiMaker, CaloRecoDigiMaker, CaloHitMaker        ## calorimeter
                         , CaloProtoClusterMaker, CaloClusterMaker
                         , CrvDigi, CrvRecoPulses, CrvCoincidenceClusterFinder   ## CRV
                         , LineFinder, KKLine                                    ## track reco
                        ]

physics.path_e0       : [ "defaultOutput" ]                  ## [defaultOutput]/[]           ## "p0" ]  ## defined in Stntuple/fcl/stntuple_tables.fcl

services.TFileService.fileName              : "/dev/null" ##
# physics.analyzers.InitStntuple.THistModule.histFileName : "/dev/null" ## "nts.mu2e.kpp00s001r104n000.md_r110_n007.125470_000001.stn"

outputs.defaultOutput.fileName        : "rec.mu2e.IDSID.cr_r110_n007.000000_000000.art"

#include "Stntuple/fcl/output_commands.fcl"

physics.analyzers.InitStntuple.SelectEvents: [ "t0" ]     ## keep only events that passed t0

services.message.destinations.log.categories.ArtReport.reportEvery : 1
services.message.destinations.log.categories.ArtReport.limit       : 1000
services.message.destinations.log.categories.ArtReport.timespan    : 300

services.GeometryService.bFieldFile: "Offline/Mu2eG4/geom/bfgeom_no_field.txt"
services.GeometryService.inputFile : "Offline/Mu2eG4/geom/geom_common_extracted_v06.txt"
#------------------------------------------------------------------------------
# tracking fcl-level mods
#------------------------------------------------------------------------------
#include "PassN/Tracker/TrkReco_epilog.fcl"
physics.producers.LineFinder.TimeClusterCollection    : "TimeCluster"
# /comment out for for validation/ physics.producers.KKLine.KKFitSettings.UseCaloCluster : false  ## for now, don't use calo clusters in the fit
physics.producers.KKLine.KKFitSettings.SaveMaterialXings     : true
physics.producers.KKLine.ModuleSettings.PrintLevel : 0 ## 10
#include "Offline/CRVReco/fcl/epilog_extracted.fcl"
#----------------------------------------------------------------------
#  overrides by submit_mu2e_job.py
#----------------------------------------------------------------------
# source.fileNames : [ "/projects/mu2e/data/projects/vst/datasets/kpp00s002r104n000/raw.mu2e.kpp00s000r105n000.filter_tc_calc.125470_000001.art" ]
